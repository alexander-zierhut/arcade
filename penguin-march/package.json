{
  "name": "penguin-march-game",
  "version": "1.0.2",
  "private": true,
  "description": "A gate-runner for the browser: steer a waddle of penguins through numbered gates, grow the crowd, beat the walrus. No build step: open index.html.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "node tests/browser/run.js",
    "preview": "node tests/browser/preview.js",
    "serve": "python3 -m http.server 8090",
    "release": "bash scripts/release.sh",
    "serve:dist": "python3 -m http.server 8091 --directory dist"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
